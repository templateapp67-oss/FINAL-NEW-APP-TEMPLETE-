# Browser/public configuration (client shared under src/lib/supabase.ts).
# URL must be the live Nexora project; the anon key is the PUBLIC project key
# (safe for browsers — never a service_role/private key).
#
# NOTE — Step 5 (Photo Gallery) uploads: these two values are also the cloud
# STORAGE credentials. Gallery/logo/hero images upload to the Supabase Storage
# bucket `salon-media` through this anon-key client. When they are missing or
# wrong the builder runs in offline/demo mode: photos are kept inside the
# draft as Base64 fallbacks instead of reaching the media library.
VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Compatibility aliases for deployments that still use Next.js-style names.
# Values must match the VITE_* pair above and the same canonical project.
NEXT_PUBLIC_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Stable public origin used in confirmation/OAuth/recovery emails.
# Never use localhost or a temporary preview URL in deployed environments.
VITE_AUTH_REDIRECT_ORIGIN=https://your-app.example.com
VITE_GOOGLE_OAUTH_ENABLED=false
# White-label base host. Must match brandConfig.platform.websiteUrl.
# Live deployment: https://final-new-app-templete.vercel.app
# Vercel `*.vercel.app` does not support wildcard business subdomains, so
# public business URLs use the path form:
#   https://final-new-app-templete.vercel.app/<business-slug>
NEXORA_BASE_HOST=final-new-app-templete.vercel.app

# Server-only Supabase configuration. Never prefix the service-role key with VITE_.
SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Razorpay configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated deployment origins allowed to call APIs cross-origin.
# Same-origin requests are allowed automatically.
# If the builder UI is served from a DIFFERENT origin than the API, that
# origin MUST be listed here — otherwise the Step-5 draft-save fallback
# (/api/owner/save-website-draft) is rejected with a CORS/origin error.
APP_ORIGIN=http://localhost:3000
ALLOWED_API_ORIGINS=http://localhost:3000

# Optional server integrations
GEMINI_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_APP_IDENTIFIER=NexoraSalonWebsiteBuilder/1.0
NOMINATIM_REFERER=http://localhost:3000

# --- M60/M63 remediation configuration (all optional) ---
# Allow deterministic local refunds on deployments WITHOUT Razorpay keys.
# Never enable on a deployment that accepts real customer money.
NEXORA_ALLOW_LOCAL_REFUNDS=
# Canonical public origin used by /robots.txt and /sitemap.xml. Falls back to
# the request host when unset. Set this on production deployments.
PUBLIC_BASE_URL=
# Security headers: strict framing/HSTS are emitted in production or when
# NEXORA_SECURITY_HEADERS=1. NEXORA_FRAME_ANCESTORS customizes the CSP
# frame-ancestors source list (default "'self'"). NEXORA_CSP ships as
# Content-Security-Policy-Report-Only unless NEXORA_CSP_REPORT_ONLY=0.
NEXORA_SECURITY_HEADERS=
NEXORA_FRAME_ANCESTORS=
NEXORA_CSP=
NEXORA_CSP_REPORT_ONLY=
